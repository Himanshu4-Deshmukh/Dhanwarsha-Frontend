{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/landing.html",
      "destination": "/landing.html"
    },
    {
      "source": "/((?!api(?:/|$)|landing\\.html|assets(?:/|$)|sw\\.js|workbox-.*\\.js|manifest\\.json|favicon\\.ico|logo\\.jpeg|placeholder\\.svg|pwa-.*\\.svg|robots\\.txt|.*\\..*).+)",
      "destination": "/index.html"
    }
  ]
}
