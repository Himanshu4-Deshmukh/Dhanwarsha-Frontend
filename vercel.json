{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/home",
      "destination": "/app.html"
    },
    {
      "source": "/auth",
      "destination": "/app.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/install",
      "destination": "/app.html"
    },
    {
      "source": "/install/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/time-bazar",
      "destination": "/app.html"
    },
    {
      "source": "/sports",
      "destination": "/app.html"
    },
    {
      "source": "/lottery",
      "destination": "/app.html"
    },
    {
      "source": "/wallet",
      "destination": "/app.html"
    },
    {
      "source": "/history",
      "destination": "/app.html"
    },
    {
      "source": "/profile",
      "destination": "/app.html"
    }
  ]
}
